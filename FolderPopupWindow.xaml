<Window x:Class="Pastel.FolderPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Topmost="True" AllowDrop="True" UseLayoutRounding="True"
        KeyDown="Window_KeyDown" PreviewMouseWheel="Window_MouseWheel"
        DragOver="Window_DragOver" Drop="Window_Drop">

    <!-- Balão: o fundo (com a ponta que aponta para o ícone da pasta) é desenhado em código (UpdateBubble);
         cores seguem o tema escolhido. Nunito 600 se estiver instalada; senão, a fonte do sistema. -->
    <Grid x:Name="Root" Margin="16">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Grid.RenderTransform>

        <Path x:Name="Bubble" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Path.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.38" Color="Black" />
            </Path.Effect>
        </Path>

        <StackPanel x:Name="BubbleContent" Margin="16,14,16,16" MinWidth="200" SizeChanged="Content_SizeChanged">
            <TextBlock x:Name="HeaderText" FontFamily="Nunito, Segoe UI Variable Display, Segoe UI" FontSize="14"
                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10" />
            <TextBlock x:Name="EmptyHint" FontFamily="Nunito, Segoe UI Variable Text, Segoe UI" FontSize="12"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="220" Margin="0,8,0,8"
                       Text="Arraste apps pra cá ou pro ícone da pasta." />

            <!-- Páginas lado a lado, como os apps fixados do Menu Iniciar -->
            <!-- Canvas (e não Grid): o Grid recorta o que é maior que ele, e o recorte andaria junto
                 com a animação de deslocamento, escondendo as outras páginas. -->
            <Canvas x:Name="Viewport" ClipToBounds="True" HorizontalAlignment="Center">
                <StackPanel x:Name="PagesHost" Orientation="Horizontal" Canvas.Left="0" Canvas.Top="0">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="PagesShift" />
                    </StackPanel.RenderTransform>
                </StackPanel>
            </Canvas>
            <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" />
        </StackPanel>
    </Grid>
</Window>
