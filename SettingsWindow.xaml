<Window x:Class="Pastel.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pastel – Configurações" Width="920" Height="640" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="Nunito, Segoe UI Variable Text, Segoe UI" FontSize="13">

    <!-- Os pincéis (Brush.*) são definidos em código conforme o tema; aqui ficam só os estilos. -->
    <Window.Resources>

        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="10" Padding="12,9" Margin="0,2" Background="Transparent" Cursor="Hand">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.NavActive}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Opção de um grupo (ex.: Seguir o Windows | Claro | Escuro) -->
        <Style x:Key="SegButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Padding="13,6" Margin="2" Background="Transparent" Cursor="Hand">
                            <ContentPresenter x:Name="Cp" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Violet}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="16,8" Background="{DynamicResource Brush.Violet}" Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.9" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.8" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="13,7" BorderThickness="1"
                                BorderBrush="{DynamicResource Brush.CardBorder}" Background="Transparent" Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Menu lateral -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Nav}" Padding="14,18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,20">
                    <ContentControl x:Name="BrandSymbol" Width="34" Height="34" />
                    <TextBlock Text="Pastel" FontFamily="Fredoka, Nunito, Segoe UI Variable Display, Segoe UI" FontSize="22"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" x:Name="NavFooter" FontSize="11" Opacity="0.6" Margin="8,0,0,0" TextWrapping="Wrap" />
                <StackPanel x:Name="Nav" />
            </DockPanel>
        </Border>

        <!-- Conteúdo -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0">
            <StackPanel x:Name="Page" Margin="34,28,34,28" />
        </ScrollViewer>
    </Grid>
</Window>
