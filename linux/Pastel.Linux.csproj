<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pastel para Linux (KDE Plasma). Projeto separado do Pastel do Windows (WPF), na raiz. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>pastel</AssemblyName>
    <RootNamespace>Pastel</RootNamespace>
    <Version>0.1.0</Version>
    <!-- sem depender do ICU do sistema (nem toda instalação mínima tem) -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Svg.Skia" Version="11.3.0" />
    <!-- O Avalonia 11.3 usa o SkiaSharp 3.x no código, mas arrasta o binário nativo de Linux da versão 2.88 (incompatível:
         o app aborta ao desenhar). Fixar o nativo na MESMA versão do código. Achado rodando num Ubuntu de verdade. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.116.1" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- a ferramenta de teste enxerga as classes internas -->
    <InternalsVisibleTo Include="PastelHarness" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- ferramentas de teste ficam em outro projeto -->
    <Compile Remove="Harness\**" />
    <AvaloniaXaml Remove="Harness\**" />
    <EmbeddedResource Remove="Harness\**" />
    <None Remove="Harness\**" />
  </ItemGroup>

</Project>
